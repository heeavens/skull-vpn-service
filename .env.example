# Public URLs
APP_BASE_URL=https://app.example.com
PUBLIC_TELEGRAM_BOT_USERNAME=replace_me_bot
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.example.com

# Telegram
TELEGRAM_BOT_TOKEN=000000000:replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-random-secret
ADMIN_TELEGRAM_CHAT_ID=123456789
# SUPPORT_CHAT_ID defaults to ADMIN_TELEGRAM_CHAT_ID when empty.
SUPPORT_CHAT_ID=

# Stripe test mode only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2025-02-24.acacia
PAYMENT_CURRENCY=eur
STRIPE_LIVEMODE_ALLOWED=false

# Application storage and cryptography
DATABASE_URL=/data/app.db
SESSION_SECRET=replace-with-session-random-secret-material
DATA_ENCRYPTION_KEY=replace-with-data-encryption-random-key

# Internal Marzban API
MARZBAN_BASE_URL=http://marzban:8000
MARZBAN_ADMIN_USERNAME=replace_me
MARZBAN_ADMIN_PASSWORD=replace_me
MARZBAN_VLESS_INBOUND_TAGS=VLESS_TCP_REALITY

# Runtime
LOG_LEVEL=info
NODE_ENV=production
